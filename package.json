{
  "name": "wires",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --dir apps/simulator dev",
    "engine:build": "./engine/gradlew -p engine makeEngineSite --console plain",
    "build": "pnpm engine:build && pnpm --dir apps/simulator build",
    "check:core": "node tools/check_core.mjs",
    "check:react": "pnpm --dir apps/simulator check",
    "check": "pnpm check:core && pnpm check:react && pnpm check:reference",
    "verify": "pnpm engine:build && pnpm check",
    "deps:install": "pnpm --dir apps/simulator install --frozen-lockfile",
    "check:reference": "node tools/upstream-boundary/replay.mjs build/engine-site tools/upstream-boundary/reference/*.jsonl.gz"
  }
}
